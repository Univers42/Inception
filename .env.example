# Template for srcs/.env — `make setup` generates srcs/.env from this file
# automatically (substituting the login), or copy and edit it yourself.

DOMAIN_NAME=login.42.fr

# TLS certificates (inside the nginx container)
CERTS_CRT=/etc/nginx/ssl/inception.crt
CERTS_KEY=/etc/nginx/ssl/inception.key

# MariaDB
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser

# WordPress site
WP_TITLE=Inception
WP_ADMIN_USER=superuser
WP_ADMIN_EMAIL=superuser@login.42.fr
WP_USER=editor
WP_USER_EMAIL=editor@login.42.fr
