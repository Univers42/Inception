# Template for srcs/.env — `make setup` generates srcs/.env from this file
# automatically (substituting the login), or copy and edit it yourself.

DOMAIN_NAME=login.42.fr

# TLS certificates (inside the nginx container)
CERTS_CRT=/etc/nginx/ssl/inception.crt
CERTS_KEY=/etc/nginx/ssl/inception.key

# MariaDB
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser

# WordPress site
WP_TITLE=Inception
WP_ADMIN_USER=superuser
WP_ADMIN_EMAIL=superuser@login.42.fr
WP_USER=editor
WP_USER_EMAIL=editor@login.42.fr

# ── Bonus services ──────────────────────────────────────────────────
# Redis object cache (no password: it is not reachable outside the
# docker network, and no host port is published for it)
WP_REDIS_HOST=redis
WP_REDIS_PORT=6379

# FTP into the WordPress volume. The password is a Docker secret
# (secrets/ftp_password.txt), never an environment variable.
FTP_USER=ftpuser
# Address advertised for passive data connections. Both routes in reach
# the server over loopback, so this is correct for the VM and for the
# physical host through VirtualBox NAT alike.
FTP_PASV_ADDRESS=127.0.0.1

# Scheduled database backups: cron expression and how many to keep.
BACKUP_CRON=0 */6 * * *
BACKUP_KEEP=7

# ── Lab: animated static site (/lab/) + its API (/api/v1/) ─────────
# The API owns its own database and user, created by the mariadb
# entrypoint on boot. Its password is a Docker secret
# (secrets/api_db_password.txt) and is never an environment variable.
# The API user has no grant on the WordPress database.
API_DB_HOST=mariadb
API_DB_PORT=3306
API_DB_NAME=lab
API_DB_USER=labuser
# Cache-aside store, shared with the WordPress object cache. The API
# namespaces every key under "lab:" so the two never collide.
API_REDIS_HOST=redis
API_REDIS_PORT=6379
