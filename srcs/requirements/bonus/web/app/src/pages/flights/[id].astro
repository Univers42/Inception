---
// One page per flight that existed when the site was built. A flight created
// later has no page on disk: the 404 page recognises the URL and draws it
// live from the API instead.
import Base from '../../layouts/Base.astro';
import Panel from '../../components/chrome/Panel.astro';
import Route from '../../components/chrome/Route.astro';
import snapshot from '../../data/flights.json';
import { fmt, type Flight } from '../../lib/api';

export function getStaticPaths() {
  return ((snapshot as any).flights as Flight[]).map((f) => ({ params: { id: String(f.id) }, props: { f } }));
}
const { f } = Astro.props as { f: Flight };
const base = import.meta.env.BASE_URL;
---
<Base title={f.callsign} page="flights" description={`Flight ${f.callsign} from ${f.origin} to ${f.destination}.`}>
  <p class="mono"><a href={`${base}flights/`}>◄ departures</a></p>
  <Panel live label={`flight ${f.callsign}`}>
    <Fragment slot="title">{f.callsign}<span class="sep">═</span><span class="v" id="fl-status">{f.status}</span><span class="sep">═</span>id {f.id}</Fragment>
    <div class="flight" data-flight-id={f.id}>
      <Route origin={f.origin} destination={f.destination} />
      <dl class="kv">
        <dt>route</dt><dd class="mono">{f.origin} <span class="arrow">─►</span> {f.destination}</dd>
        <dt>status</dt><dd><span id="fl-status-cell" class={`st st-${f.status}`}>{f.status}</span></dd>
        <dt>payload</dt><dd class="mono">{f.payload_kb} kB</dd>
        <dt>note</dt><dd>{f.note || '—'}</dd>
        <dt>created</dt><dd class="mono">{fmt.date(f.created_at)} {fmt.utc(f.created_at)}</dd>
        <dt>source</dt><dd class="mono muted" id="fl-source">build snapshot</dd>
      </dl>
    </div>
  </Panel>
</Base>
<script src="../../components/islands/flight.ts"></script>
