---
// POST /api/v1/flights from a form. Works as a plain form description for
// screen readers; dispatch.ts sends it as JSON and shows the API's answer,
// including which field a 422 names and how long a 429 says to wait.
import { CABINETS } from '../../lib/api';
---
<form id="dispatch" class="dispatch" novalidate>
  <div class="grid2">
    <div class="field">
      <label for="d-origin">from</label>
      <select id="d-origin" name="origin" aria-describedby="d-origin-err">
        {CABINETS.map((c, i) => <option value={c} selected={i === 0}>{c}</option>)}
      </select>
      <p class="hint err" id="d-origin-err" hidden></p>
    </div>
    <div class="field">
      <label for="d-destination">to</label>
      <select id="d-destination" name="destination" aria-describedby="d-destination-err">
        {CABINETS.map((c, i) => <option value={c} selected={i === 5}>{c}</option>)}
      </select>
      <p class="hint err" id="d-destination-err" hidden></p>
    </div>
    <div class="field">
      <label for="d-payload_kb">payload kB</label>
      <input id="d-payload_kb" name="payload_kb" type="text" inputmode="numeric" value="4" aria-describedby="d-payload_kb-hint d-payload_kb-err" />
      <p class="hint" id="d-payload_kb-hint">1 – 65 536</p>
      <p class="hint err" id="d-payload_kb-err" hidden></p>
    </div>
    <div class="field">
      <label for="d-note">note</label>
      <input id="d-note" name="note" type="text" maxlength="160" aria-describedby="d-note-hint d-note-err" />
      <p class="hint" id="d-note-hint">optional, 140 characters</p>
      <p class="hint err" id="d-note-err" hidden></p>
    </div>
  </div>
  <div class="row">
    <button type="submit" id="d-send">dispatch</button>
    <span class="mono muted">or <kbd>:</kbd><code>dispatch nginx api 4</code></span>
  </div>
  <p class="mono" id="d-out" role="status" aria-live="polite"></p>
</form>
<script src="./dispatch.ts"></script>
