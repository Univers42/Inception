# Secrets (NEVER commit)
secrets/

# Environment files with real values. The bare pattern matters: the subject puts
# the project's env at srcs/.env, but a stray .env at the repository root is NOT
# covered by that path and would be tracked — which is how a token ends up in a
# commit. Ignore both.
.env
srcs/.env

# Host data volumes
/home/*/data/

# OS / editor
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# The shell copied into the images by make setup (see srcs/shell/README.md)
srcs/shell/hellish

# One person's local overrides — private to whoever pushes them (42ctl seals *.local to
# the pusher alone); never shared, never committed.
.env.local
srcs/.env.local
